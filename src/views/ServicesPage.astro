---
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import ServiceCard from "@components/ui/ServiceCard.astro";
import FAQ from "@/components/sections/FAQ.astro";
import CTA from "@/components/sections/CTA.astro";
import { getServices } from "@/data/services";
import { getLocaleFromUrl } from "@/i18n/config";
import { pageAlternates } from "@/i18n/routes";
import { useTranslations } from "@/i18n/ui";

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale).servicesPage;
const services = getServices(locale);
---

<BaseLayout title={t.title} description={t.description} alternates={pageAlternates("services")}>
  <Container class="items-center">
    <!-- Headline -->
    <div
      class="mx-auto mt-12 mb-16 flex max-w-2xl flex-col items-center gap-6 text-center md:mb-20"
    >
      <h1
        data-reveal="words"
        class="font-display text-4xl leading-[0.8] font-bold uppercase md:text-6xl lg:text-[72px]"
      >
        {t.h1}
      </h1>
      <p data-reveal="fade" class="max-w-lg text-lg text-(--color-text-primary)/60">
        {t.subtitle}
      </p>
    </div>

    <!-- Services list: each card animates individually via ServiceCard's own script -->
    <ul class="flex w-full max-w-7xl flex-col justify-center gap-5 self-center md:gap-6">
      {services.map((service, index) => <ServiceCard service={service} index={index} />)}
    </ul>

    <FAQ />
    <CTA />
  </Container>
</BaseLayout>
