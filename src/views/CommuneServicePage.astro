---
import { Image, getImage } from "astro:assets";
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@components/ui/Container.astro";
import Button from "@components/ui/Button.astro";
import SectionLabel from "@components/ui/SectionLabel.astro";
import CTA from "@/components/sections/CTA.astro";
import StarRating from "@components/ui/StarRating.astro";
import { getService } from "@/data/services";
import { getRotatingReviews } from "@/data/reviews";
import { getCommune, getCommuneServiceContent } from "@/data/communes.i18n";
import { getLocaleFromUrl } from "@/i18n/config";
import { communeServiceAlternates, communeServicePath, pagePath } from "@/i18n/routes";
import { useTranslations } from "@/i18n/ui";

interface Props {
  /** Locale-independent ids (French slugs). */
  communeSlug: string;
  serviceSlug: string;
}

const { communeSlug, serviceSlug } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const tc = t.commune;
const contactPath = pagePath("contact", locale);

const commune = getCommune(communeSlug, locale)!;
const content = getCommuneServiceContent(communeSlug, serviceSlug, locale);
const service = getService(serviceSlug, locale)!;

const faqItems = content.faqs;

const reviews = getRotatingReviews(`${communeSlug}-${serviceSlug}`, 3);
// Reviews are quoted as written on Google (in French), never translated.
const reviewLang = locale === "fr" ? undefined : "fr";

const neighborCommunes = commune.neighbors
  .map((slug) => getCommune(slug, locale))
  .filter((c) => c !== undefined);

const heroOptimized = await getImage({ src: service.image, width: 1200, format: "webp" });
const heroPreloadHref = heroOptimized.src;
const heroPreloadType = "image/webp";
---

<BaseLayout
  title={content.metaTitle}
  description={content.metaDescription}
  image={service.image.src}
  alternates={communeServiceAlternates(communeSlug, serviceSlug)}
>
  <link slot="head" rel="preload" as="image" href={heroPreloadHref} type={heroPreloadType} />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqItems.map(({ question, answer }) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    })}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: t.breadcrumb.home,
          item: `https://cleanngo.be${locale === "fr" ? "" : pagePath("home", locale)}`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: service.name,
          item: `https://cleanngo.be${service.href}`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: tc.serviceIn(service.name, commune.name),
          item: `https://cleanngo.be${communeServicePath(communeSlug, serviceSlug, locale)}`,
        },
      ],
    })}
  />
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      name: tc.serviceIn(service.name, commune.name),
      description: content.metaDescription,
      url: `https://cleanngo.be${communeServicePath(communeSlug, serviceSlug, locale)}/`,
      provider: {
        "@type": "LocalBusiness",
        name: "CleanNgo",
        url: "https://cleanngo.be",
        telephone: "+32486518181",
        areaServed: {
          "@type": "City",
          name: commune.name,
          postalCode: commune.postalCode,
        },
      },
      areaServed: { "@type": "City", name: commune.name, postalCode: commune.postalCode },
      serviceType: service.name,
      image: `https://cleanngo.be${service.image.src}`,
      priceRange: "€€",
      offers: {
        "@type": "Offer",
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        areaServed: { "@type": "City", name: commune.name },
      },
      review: reviews.map((r) => ({
        "@type": "Review",
        author: { "@type": "Person", name: r.author },
        reviewRating: { "@type": "Rating", ratingValue: String(r.rating), bestRating: "5" },
        reviewBody: r.text,
      })),
    })}
  />

  <Container class="mt-12 items-center">
    <!-- Headline -->
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-8 text-center">
      <h1
        data-reveal="words"
        class="font-display text-5xl leading-[0.9] font-bold uppercase md:text-7xl lg:text-8xl"
      >
        {content.h1}
      </h1>

      <div data-reveal="cards" class="flex flex-wrap justify-center gap-4">
        <Button
          href={contactPath}
          size="lg"
          data-umami-event="cta_click"
          data-umami-event-location="commune_service_hero"
          data-umami-event-destination="contact"
          data-umami-event-commune={commune.slug}
          data-umami-event-service={serviceSlug}
        >
          {tc.book}
        </Button>
        <Button
          href={service.href}
          size="lg"
          variant="secondary"
          data-umami-event="services_all_click"
          data-umami-event-location="commune_service_hero"
          data-umami-event-destination="service"
          data-umami-event-commune={commune.slug}
          data-umami-event-service={serviceSlug}
        >
          {tc.seeService(service)}
        </Button>
      </div>
    </div>

    <!-- Hero image -->
    <div data-reveal="wipe" class="mt-6 w-full max-w-5xl overflow-hidden rounded-3xl">
      <Image
        src={service.image}
        alt={tc.serviceIn(service.name, commune.name)}
        widths={[480, 800, 1200, 1400]}
        width={1400}
        height={1867}
        sizes="(max-width: 480px) 480px, (max-width: 767px) 100vw, (max-width: 1280px) 80vw, 1024px"
        quality={50}
        loading="eager"
        fetchpriority="high"
        class="h-72 w-full object-cover md:h-130 lg:h-160"
      />
    </div>

    <div class="mx-auto flex w-full max-w-7xl flex-col gap-8">
    <!-- Local intro -->
    <div class="mx-auto flex w-full max-w-4xl flex-col gap-5 py-8 text-center">
      {
        content.intro.map((paragraph) => (
          <p
            data-reveal="fade"
            class="font-accent m-0 text-lg leading-relaxed text-(--color-text-primary)/70"
          >
            {paragraph}
          </p>
        ))
      }
      <div data-reveal="fade" class="mt-3 flex justify-center">
        <Button
          href={contactPath}
          size="lg"
          data-umami-event="cta_click"
          data-umami-event-location="commune_service_intro"
          data-umami-event-destination="contact"
          data-umami-event-commune={commune.slug}
          data-umami-event-service={serviceSlug}
        >
          {tc.bookIn(commune.name)}
        </Button>
      </div>
    </div>

    <!-- What's included (reused from the service) -->
    {
      service.features && service.features.length > 0 && (
        <section class="w-full rounded-3xl bg-(--color-surface-secondary) p-8 lg:p-10">
          <div class="mb-10 flex flex-col items-center gap-4 text-center">
            <SectionLabel text={tc.includedLabel} bg="bg-(--color-background)" />
            <h2
              data-reveal="words"
              class="font-display m-0 text-5xl leading-[0.9] font-bold uppercase lg:text-6xl"
            >
              {tc.inCommune(commune.name)}
            </h2>
          </div>
          <ul data-reveal="cards" class="flex flex-col gap-4">
            {service.features.map((feature) => (
              <li class="flex w-full items-center gap-6 rounded-2xl bg-(--color-background) px-6 py-5">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-(--color-accent) text-(--color-text-primary)">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M20 6L9 17L4 12"
                      stroke="currentColor"
                      stroke-width="5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span class="text-xl leading-snug font-semibold md:text-2xl">{feature}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- How it works (reused from the service) -->
    <section class="w-full">
      <div class="mb-10 flex flex-col items-center gap-4 text-center">
        <SectionLabel text={tc.processLabel} />
        <h2
          data-reveal="words"
          class="font-display m-0 text-5xl leading-[0.9] font-bold uppercase lg:text-6xl"
        >
          {tc.processTitle(service, commune.name)}
        </h2>
      </div>
      <div data-reveal="cards" class="flex w-full flex-col gap-4">
        {
          service.process.map((step, index) => (
            <div
              class="sticky flex flex-col gap-12 rounded-3xl bg-(--color-surface-secondary) p-8 lg:p-10"
              style={`top: calc(7.5rem + ${index * 0.5}rem); z-index: ${10 + index};`}
            >
              <span class="font-display text-7xl leading-none font-bold text-(--color-accent) lg:text-8xl">
                {step.step}
              </span>
              <div class="flex flex-col gap-4">
                <h3 class="font-display m-0 text-5xl font-bold text-(--color-text-primary) lg:text-7xl">
                  {step.title}
                </h3>
                <p class="m-0 text-lg leading-relaxed text-(--color-text-primary)/60">
                  {step.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Testimonials (rotating pool, no duplicated order across pages) -->
    <section class="w-full">
      <div class="mb-10 flex flex-col items-center gap-4 text-center">
        <SectionLabel text={tc.testimonialsLabel} bg="bg-(--color-surface-secondary)" />
        <h2
          data-reveal="words"
          class="font-display m-0 text-5xl leading-[0.9] font-bold uppercase lg:text-6xl"
        >
          {tc.testimonialsTitle}
        </h2>
      </div>
      <div data-reveal="cards" class="grid w-full grid-cols-1 gap-4 md:grid-cols-3">
        {
          reviews.map((review) => (
            <div class="flex flex-col gap-6 rounded-2xl bg-(--color-surface-secondary) p-6">
              <div class="flex flex-col gap-4">
                <StarRating rating={review.rating} />
                <p class="m-0 text-base leading-relaxed text-(--color-text-primary)" lang={reviewLang}>
                  "{review.text}"
                </p>
              </div>
              <p class="m-0 text-sm font-semibold text-(--color-text-primary)/70">
                {review.author} ({t.reviewSource})
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- FAQ: 2 general questions reused + 1 commune-specific -->
    <section class="w-full">
      <div class="rounded-3xl bg-(--color-surface-secondary) px-6 py-16 md:px-12 md:py-24">
        <div class="mx-auto mb-16 flex max-w-2xl flex-col items-center gap-4 text-center">
          <SectionLabel text="FAQ" />
          <h2
            data-reveal="words"
            class="font-display text-5xl leading-[0.8] font-bold tracking-tight uppercase lg:text-[64px]"
          >
            {tc.faqTitle(commune.name)}
          </h2>
        </div>
        <div class="mx-auto flex max-w-2xl flex-col gap-3">
          {
            faqItems.map((faq) => (
              <div class="commune-faq-item rounded-xl bg-white px-6 py-5">
                <button
                  class="commune-faq-trigger flex w-full items-center justify-between gap-6 text-left"
                  aria-expanded="false"
                >
                  <span class="text-lg leading-snug font-semibold md:text-2xl">{faq.question}</span>
                  <span class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-(--color-accent)">
                    <span class="absolute h-0.5 w-3 rounded-full bg-(--color-text-primary)" />
                    <span class="commune-faq-v-bar absolute h-3 w-0.5 rounded-full bg-(--color-text-primary) transition-transform duration-300" />
                  </span>
                </button>
                <div class="commune-faq-body grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out">
                  <div class="overflow-hidden">
                    <p class="m-0 pt-5 text-lg leading-relaxed font-medium opacity-60">
                      {faq.answer}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Neighboring communes + general service link -->
    <section class="w-full rounded-3xl bg-(--color-surface-secondary) p-8 lg:p-10">
      <div class="mb-8 flex flex-col gap-4">
        <SectionLabel text={tc.neighborsLabel} bg="bg-(--color-background)" />
        <h2
          data-reveal="words"
          class="font-display m-0 text-5xl leading-[0.9] font-bold uppercase lg:text-6xl"
        >
          {tc.neighborsTitle(commune.name)}
        </h2>
      </div>
      <div data-reveal="cards" class="grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          neighborCommunes.map((neighbor) => (
            <a
              href={communeServicePath(neighbor.id, serviceSlug, locale)}
              class="group flex flex-col gap-8 rounded-2xl bg-(--color-background) p-6 transition-colors duration-300 hover:bg-(--color-accent) lg:p-8"
              data-umami-event="commune_neighbor_click"
              data-umami-event-location="commune_service_neighbors"
              data-umami-event-commune={commune.slug}
              data-umami-event-destination={neighbor.slug}
            >
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-(--color-surface-secondary) text-(--color-text-primary)">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 32 32" fill="none">
                  <path
                    d="M25.334 13.3333C25.334 22.6666 16.0007 29.3333 16.0007 29.3333C16.0007 29.3333 6.66732 22.6666 6.66732 13.3333C6.66732 10.8464 7.65958 8.46079 9.42659 6.70379C11.1936 4.94679 13.5792 3.99997 16.0673 3.99997C18.5539 3.99997 20.9385 4.94679 22.7055 6.70379C24.4726 8.46079 25.3327 10.8464 25.334 13.3333Z"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M16.0007 17.3333C18.2098 17.3333 20.0007 15.5425 20.0007 13.3333C20.0007 11.1242 18.2098 9.33329 16.0007 9.33329C13.7915 9.33329 12.0007 11.1242 12.0007 13.3333C12.0007 15.5425 13.7915 17.3333 16.0007 17.3333Z"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <div class="flex flex-col gap-2">
                <h3 class="font-display m-0 text-xl font-bold text-(--color-text-primary)">
                  {neighbor.name}
                </h3>
                <p class="m-0 text-sm leading-relaxed font-semibold text-(--color-text-primary)/70">
                  {service.name}
                </p>
              </div>
            </a>
          ))
        }
        <a
          href={service.href}
          class="group flex flex-col gap-8 rounded-2xl bg-(--color-text-primary) p-6 text-(--color-surface) transition-opacity duration-300 hover:opacity-85 lg:p-8"
          data-umami-event="services_all_click"
          data-umami-event-location="commune_service_neighbors"
          data-umami-event-commune={commune.slug}
          data-umami-event-service={serviceSlug}
        >
          <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-white/10 text-(--color-surface)">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 32 32" fill="none">
              <path
                d="M4 8L12 5.33333L20 8L28 5.33333V24L20 26.6667L12 24L4 26.6667V8Z"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M12 5.33333V24M20 8V26.6667"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <div class="flex flex-col gap-2">
            <h3 class="font-display m-0 text-xl font-bold">{service.name}</h3>
            <p class="m-0 text-sm leading-relaxed font-semibold text-(--color-surface)/70">
              {tc.wholeRegion}
            </p>
          </div>
        </a>
      </div>
    </section>

    <CTA />
    </div>
  </Container>
</BaseLayout>

<style>
  .commune-faq-item.is-open .commune-faq-body {
    grid-template-rows: 1fr;
  }
  .commune-faq-item.is-open .commune-faq-v-bar {
    transform: rotate(90deg);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".commune-faq-item").forEach((item) => {
    item.querySelector(".commune-faq-trigger")?.addEventListener("click", () => {
      const isOpen = item.classList.contains("is-open");

      document.querySelectorAll(".commune-faq-item").forEach((other) => {
        other.classList.remove("is-open");
        other.querySelector(".commune-faq-trigger")?.setAttribute("aria-expanded", "false");
      });

      if (!isOpen) {
        item.classList.add("is-open");
        item.querySelector(".commune-faq-trigger")?.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
