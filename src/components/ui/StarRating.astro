---
// Five stars, `rating` of them filled. Uses the #icon-star symbol from IconSprite.
import { getLocaleFromUrl } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";
interface Props {
  rating?: number;
  size?: "sm" | "lg";
}

const { rating = 5, size = "sm" } = Astro.props;
const iconClass = size === "lg" ? "h-6 w-6" : "h-4 w-4";
const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<div class="flex gap-1 text-amber-400" role="img" aria-label={t.stars(rating)}>
  {
    Array.from({ length: 5 }, (_, i) => (
      <svg class={iconClass} fill={i < rating ? "currentColor" : "none"}>
        <use href="#icon-star" />
      </svg>
    ))
  }
</div>
