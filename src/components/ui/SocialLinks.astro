---

---

<div class="flex items-center gap-4">
  <!-- Instagram -->
  <a
    href="https://www.instagram.com/clean.ngo_"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="CleanNgo sur Instagram"
    class="inline-flex items-center justify-center transition-transform duration-200 hover:scale-110"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="instagram-gradient" x1="0" y1="24" x2="24" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#f58529"></stop>
          <stop offset="0.35" stop-color="#feda77"></stop>
          <stop offset="0.6" stop-color="#dd2a7b"></stop>
          <stop offset="0.82" stop-color="#8134af"></stop>
          <stop offset="1" stop-color="#515bd4"></stop>
        </linearGradient>
      </defs>
      <rect x="2" y="2" width="20" height="20" rx="6" fill="url(#instagram-gradient)"></rect>
      <rect x="7" y="7" width="10" height="10" rx="3" fill="none" stroke="#ffffff" stroke-width="2"></rect>
      <circle cx="12" cy="12" r="2.6" fill="none" stroke="#ffffff" stroke-width="2"></circle>
      <circle cx="17.2" cy="6.8" r="1.2" fill="#ffffff"></circle>
    </svg>
    <span class="sr-only">CleanNgo sur Instagram</span>
  </a>

  <!-- Facebook -->
  <a
    href="https://www.facebook.com/Cleanngo"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="CleanNgo sur Facebook"
    class="inline-flex items-center justify-center transition-transform duration-200 hover:scale-110"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="12" fill="#1877f2"></circle>
      <path
        d="M15.117 7.86h-1.563c-1.226 0-1.463.583-1.463 1.438v1.886h2.928l-.382 2.956h-2.546V22h-3.054v-7.86H6.5v-2.956h2.537V9.008c0-2.514 1.535-3.884 3.778-3.884 1.074 0 1.997.08 2.302.116V7.86z"
        fill="#ffffff"
      ></path>
    </svg>
    <span class="sr-only">CleanNgo sur Facebook</span>
  </a>

  <!-- WhatsApp -->
  <a
    href="https://web.whatsapp.com/send?phone=32486518181"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contacter CleanNgo sur WhatsApp"
    class="inline-flex items-center justify-center transition-transform duration-200 hover:scale-110"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="12" fill="#25d366"></circle>
      <path
        d="M6.32 18.72l.86-3.13a6.32 6.32 0 119.44.38 6.31 6.31 0 01-7.2 2.69l-3.1.06zm3.8-9.84c-.15-.33-.3-.34-.44-.34h-.38c-.13 0-.34.05-.52.24-.17.19-.66.65-.66 1.59 0 .94.67 1.84.77 1.96.1.12 1.31 2.1 3.26 2.87 1.62.65 1.95.52 2.3.49.34-.03 1.1-.44 1.26-.86.16-.43.16-.8.11-.86-.05-.07-.19-.11-.39-.2-.2-.1-1.1-.54-1.26-.6-.16-.06-.28-.09-.4.1-.11.2-.45.6-.55.73-.1.13-.21.14-.39.05-.18-.1-.78-.28-1.49-.9-.56-.5-.94-1.11-1.05-1.29-.11-.19 0-.29.08-.39.08-.08.18-.2.27-.3.09-.1.11-.18.17-.29.06-.1.03-.2-.01-.29-.05-.1-.41-.99-.58-1.36z"
        fill="#ffffff"
      ></path>
    </svg>
    <span class="sr-only">Contacter CleanNgo sur WhatsApp</span>
  </a>
</div>
