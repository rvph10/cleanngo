---
import SectionLabel from "@components/ui/SectionLabel.astro";
import { getLocaleFromUrl } from "@/i18n/config";
import { useTranslations } from "@/i18n/ui";

const t = useTranslations(getLocaleFromUrl(Astro.url)).areas;
const areas = t.list;
---

<section class="w-full" aria-label={t.sectionAria}>
  <!-- Card: heading + towns -->
  <div data-reveal="wipe" class="rounded-3xl bg-(--color-surface-secondary) p-8 lg:p-10">
    <div class="mb-8 flex flex-col gap-4">
      <SectionLabel text={t.label} />
      <h2
        data-reveal="words"
        class="font-display m-0 text-5xl leading-[0.9] font-bold uppercase lg:text-6xl"
      >
        {t.title}
      </h2>
    </div>

    <ul data-reveal="cards" class="flex flex-wrap gap-2" aria-label={t.listAria}>
      {
        areas.map((area) => (
          <li class="rounded-full bg-(--color-background) px-4 py-2 text-sm font-semibold text-(--color-text-primary)/70">
            {area}
          </li>
        ))
      }
    </ul>
  </div>
</section>
